{
  "name": "@lead/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:fetch": "tsx --env-file-if-exists=../../.env src/scripts/fetch-check.ts",
    "check:llm": "tsx --env-file-if-exists=../../.env src/scripts/llm-check.ts",
    "check:queue": "tsx --env-file-if-exists=../../.env src/scripts/queue-check.ts",
    "check:dedupe": "tsx --env-file-if-exists=../../.env src/scripts/dedupe-check.ts",
    "check:run": "tsx --env-file-if-exists=../../.env src/scripts/run-check.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.4",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@lead/core": "*",
    "bullmq": "^6.0.2",
    "cheerio": "^1.0.0",
    "domhandler": "^5.0.3",
    "ioredis": "^5.4.2",
    "playwright": "1.62.1",
    "undici": "^7.29.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
