# --- Infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgres://lead:lead@localhost:5432/lead
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage

# --- LLM (required) ---
# Every model call runs through LangChain, so switching vendors is this one var
# plus the matching key below. Nothing else in the codebase names a provider.
# google (default) | openai | anthropic
LLM_PROVIDER=google

# https://aistudio.google.com/apikey  — free tier, no card
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides. Left empty, each provider uses its cheapest tier:
#   google     gemini-3.5-flash-lite
#   openai     gpt-5.1-mini
#   anthropic  claude-haiku-4-5
# The defaults are deliberately the lite tier for both roles. Extraction is
# schema-filling and planning is one short structured plan; neither has shown a
# quality gap that justifies a costlier tier. Whoever operates the run pays for
# it, so opting up to flash or Pro belongs here, not inherited from the code.
EXTRACT_MODEL=
PLAN_MODEL=

# --- Discovery providers (at least one required) ---
# https://tavily.com  — 1,000 credits/month, perpetual free tier, no card
TAVILY_API_KEY=
# https://exa.ai  — $20 signup credit + $10/month recurring, no card
EXA_API_KEY=

# --- Enrichment (optional) ---
# https://hunter.io  — 50 credits/month, perpetual free tier
HUNTER_API_KEY=

# --- Tier 2 managed fetch (optional, adapter slot) ---
# Leave empty to disable tier 2. Challenge-blocked pages will be recorded as blocked.
SCRAPINGBEE_API_KEY=
FIRECRAWL_API_KEY=

# --- Engine tuning ---
WORKER_CONCURRENCY=4
BROWSER_POOL_SIZE=4
MAX_PAGES_PER_DOMAIN=6
GLOBAL_TIER1_ALARM_RATIO=0.25
# Set true to allow extraction of named-individual emails (GDPR: needs lawful basis).
# Default false keeps extraction to role addresses (info@, kontakt@, ...).
ALLOW_PERSONAL_EMAILS=false
